# Where game.mjs remembers the install path it found, so every tool in the repo
# answers the question once. Machine-specific, never committed.
.cache/

# Scratch space for probes and one-off scripts.
.scratch/

node_modules/
*.log

# Electron build output for the UI. ~90MB of packaged runtime, always
# reproducible from `cd ui && npm run dist`.
ui/dist/

# Build exports. These are derived from the player's own copy of the game, and
# the game's data is Shiro Games' - the generator ships, its output does not.
out/
*.bench.json

# Where `bench layouts` writes one report per weapon pair as the sweep runs.
# Same rule as above: derived from the player's own game data, never committed.
bench-layouts-*/

# Release artifacts: both are rebuilt by tools/release.mjs and the workflow.
farever-bench-v*.zip
FareverBench-v*.exe
